local colors = {
    {255, 0, 127}, {0, 255, 255}, {255, 0, 255},
    {0, 255, 0}, {0, 100, 255}, {255, 200, 0},
    {255, 100, 0}, {255, 0, 0}, {0, 255, 127},
    {100, 200, 255}, {255, 0, 85}, {0, 255, 200}
}

local staffCount = 0
local knownStaffs = {}

local function updateCounterUI()
    counterLabel.Text = "Staffs in: " .. staffCount
end

local function getRandomColor()
    local color = colors[math.random(1, #colors)]
    return string.format("rgb(%d,%d,%d)", color[1], color[2], color[3])
end

local function showNotification(username, message, role)
    local randomColor = getRandomColor()
    local roleText = role and (" <i>[" .. role .. "]</i> ") or " "
    
    notificationLabel.Text = '<font color="' .. randomColor .. '">' .. username .. '</font>' .. roleText .. message
    
    task.spawn(function()
        task.wait(NOTIFICATION_DURATION)
        if string.find(notificationLabel.Text, username) then
            notificationLabel.Text = ""
        end
    end)
end

local function handleDetectedStaff(player, role, isJoining)
    if not knownStaffs[player] then
        knownStaffs[player] = role
        staffCount = staffCount + 1
        updateCounterUI()
        
        local actionText = isJoining and "joined!" or "is already in the server!"
        showNotification(player.Name, actionText, role)
        
        -- Si es un Mod (del grupo), NO te kickea. Solo te kickea si es de la lista individual.
        if isJoining and role ~= "Mod" then
            LocalPlayer:Kick("Shit mom walked in... its over goodbye.")
        end
    end
end

local function checkPlayer(player, isJoining)
    task.spawn(function()
        local success, inGroup = pcall(function()
            return player:IsInGroup(GROUP_ID)
        end)
        
        -- Si el jugador se desconecta antes de que Roblox responda, abortamos
        if not (success and player.Parent) then return end
        
        if inGroup then
            -- Si está en el grupo, ignora la tabla individual y fuerza el rol Mod
            handleDetectedStaff(player, "Mod", isJoining)
        else
            -- Si no está en el grupo, se revisa la tabla individual como respaldo
            local playerName = player.Name:lower()
            local directRole = INDIVIDUAL_STAFFS[playerName]
            if directRole then
                handleDetectedStaff(player, directRole, isJoining)
            end
        end
    end)
end

local function makeDraggable(frame)
    local dragging, dragStart, startPos
    
    frame.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
        end
    end)
    
    frame.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            frame.Position = startPos + UDim2.new(0, delta.X, 0, delta.Y)
        end
    end)
end

makeDraggable(mainFrame)

for _, player in pairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        checkPlayer(player, false)
    end
end

Players.PlayerAdded:Connect(function(player)
    checkPlayer(player, true)
end)

Players.PlayerRemoving:Connect(function(player)
    if knownStaffs[player] then
        knownStaffs[player] = nil
        staffCount = staffCount - 1
        updateCounterUI()
        showNotification(player.Name, "left the game!", "Staff")
    end
end)

